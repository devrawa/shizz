# SERVER ONLY. Never copy this file into mobile/public or commit a real .env.
# Default demo makes no paid AI/search/voice requests.
DEMO_MODE=true
# bootstrap.sh generates a long device token. Live mode refuses tokens shorter than 32 characters.
APP_ACCESS_TOKEN=

# Chat adapters. Set at least one key plus an account-available model ID for live chat.
# Discover available IDs in app Settings. No model is declared universally "strongest".
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_API_MODE=responses
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# One additional trusted OpenAI-compatible endpoint: aggregator or self-hosted model.
# The base must include /v1, e.g. https://your-provider.example/v1.
# A local backend-only URL is allowed here because only the administrator edits it.
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=

# Explicit server routing. Blank *_MODEL uses that provider's default above.
FAST_PROVIDER=openai
FAST_MODEL=
BALANCED_PROVIDER=openai
BALANCED_MODEL=
DEEP_PROVIDER=openai
DEEP_MODEL=
MAX_OUTPUT_TOKENS=1200

# Search: Brave is preferred if both are set; otherwise Tavily.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Sorani Speech-to-Text V2. Use ADC / workload identity on the server.
GOOGLE_CLOUD_PROJECT=
GOOGLE_SPEECH_LOCATION=us-central1
GOOGLE_SPEECH_MODEL=chirp_2
# Optional local development credential file, never included in the app or ZIP:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json

# TTS: use a licensed/consenting voice with a Sorani-capable model, then evaluate it.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4_turbo

# Realtime is a separate direct speech model, NOT the selected chat provider.
# Verify current model access. Sorani quality is experimental.
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin

# Exact owned/authorized hostnames only, comma separated. No wildcards. Empty disables network security checks.
SECURITY_ALLOWED_HOSTS=

# Packaged Android origin + local browser development. Add your deployed web origin explicitly if needed.
ALLOWED_ORIGINS=https://localhost,http://localhost,http://localhost:5173

# Optional compiled helper paths; defaults are workers/bin/fetchguard and workers/bin/secretguard.
# FETCHGUARD_BIN=/app/workers/bin/fetchguard
# SECRETGUARD_BIN=/app/workers/bin/secretguard
